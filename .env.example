# PUBLICZNY WZORZEC KONFIGURACJI — ten plik nie zawiera hasla do logowania.
# Teksty "replace-with-..." oznaczaja miejsca do uzupelnienia, nie prawdziwe hasla.
# scripts/Initialize-Dukat.ps1 tworzy prywatny plik .env z losowymi sekretami.
# Wlasciwe dane lokalnego profilu odczytaj ze swojego .env na komputerze.
# Nigdy nie wpisuj prawdziwych sekretow do tego publicznego wzorca.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=dukat_db
DB_USER=dukatuser
# Haslo techniczne polaczenia backendu z PostgreSQL; nie sluzy do logowania w UI.
DB_PASSWORD=replace-with-local-password
SERVER_PORT=8082
JWT_SECRET=replace-with-at-least-32-random-bytes-in-base64
# Dane pierwszego lokalnego profilu. Zmiana zmiennej nie resetuje istniejacego konta.
DUKAT_BOOTSTRAP_USERNAME=user
DUKAT_BOOTSTRAP_PASSWORD=replace-with-local-password
DUKAT_BOOTSTRAP_EMAIL=user@dukat.local
