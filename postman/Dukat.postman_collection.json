{
  "info": {
    "name": "Dukat — scenariusz portfolio JWT",
    "description": "Uruchom na lokalnej aplikacji. Kolekcja tworzy ODDZIELNY profil demo i jego dane. Wczytaj środowisko, ustaw demoPassword (minimum 10 znaków), uruchamiaj po kolei. Nie eksportuj wygenerowanych tokenów ani hasła.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "demoUsername",
      "value": ""
    },
    {
      "key": "demoEmail",
      "value": ""
    },
    {
      "key": "sourceId",
      "value": ""
    },
    {
      "key": "targetId",
      "value": ""
    },
    {
      "key": "categoryId",
      "value": ""
    },
    {
      "key": "budgetId",
      "value": ""
    },
    {
      "key": "goalId",
      "value": ""
    },
    {
      "key": "paymentId",
      "value": ""
    },
    {
      "key": "newCategoryId",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const localDate=d=>d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');",
          "const d=new Date();pm.variables.set('today',localDate(d));pm.variables.set('month',localDate(d).slice(0,7));d.setDate(d.getDate()+7);pm.variables.set('futureDate',localDate(d));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Rejestracja oddzielnego profilu demo",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/register",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{demoUsername}}\",\n  \"email\": \"{{demoEmail}}\",\n  \"password\": \"{{demoPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const suffix=Date.now().toString();",
              "pm.collectionVariables.set('demoUsername','portfolio_'+suffix);",
              "pm.collectionVariables.set('demoEmail','portfolio_'+suffix+'@example.com');",
              "if(!(pm.environment.get('demoPassword')||'').length)throw new Error('Ustaw demoPassword w lokalnym srodowisku Postmana.');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201',()=>pm.response.to.have.status(201));",
              "const authPayload=pm.response.json();pm.collectionVariables.set('accessToken',authPayload.accessToken);pm.test('Brak hasla w profilu',()=>pm.expect(authPayload.user).not.to.have.property('password'));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Logowanie JWT",
      "request": {
        "method": "POST",
